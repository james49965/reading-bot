# Copy to .env and fill in. .env is gitignored, keep it that way.
#
#   cp .env.example .env
#   set -a; source .env; set +a
#   go run ./cmd/reading-bot

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Your numeric Telegram user ID. The bot ignores every other sender.
# Get it by messaging @userinfobot.
TELEGRAM_ALLOWED_USER_ID=

# Fine-grained PAT, scoped to the content repo only, contents: read/write.
GITHUB_TOKEN=

# The repo the bot writes reading notes into.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_BRANCH=v4
CONTENT_DIR=content/reading

# 1 = never call the GitHub write API; reply with the file content that
# would have been written. Leave this on until you trust it.
DRY_RUN=1
